            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"gemma-erp\",\n  \"prompt\": \"Extrae la intención ERP de: 'Crear producto arroz precio Bs 20 stock 100'. Responde SOLO con JSON: {\\\"intent\\\": \\\"producto_crear\\\", \\\"nombre\\\": \\\"...\\\", \\\"precio\\\": N, \\\"stock\\\": N}\",\n  \"stream\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "http://localhost:11434/api/generate",
              "protocol": "http",
              "host": ["localhost"],
              "port": "11434",
              "path": ["api", "generate"]
            }
          }
        },
        {
          "name": "NLP ERP - Listar productos",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"gemma-erp\",\n  \"prompt\": \"Classify this ERP command: 'Show me all products'. Respond ONLY with JSON: {\\\"intent\\\": \\\"producto_listar\\\", \\\"action\\\": \\\"listar\\\"}\",\n  \"stream\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "http://localhost:11434/api/generate",
              "protocol": "http",
              "host": ["localhost"],
              "port": "11434",
              "path": ["api", "generate"]
            }
          }
        }
      ]
