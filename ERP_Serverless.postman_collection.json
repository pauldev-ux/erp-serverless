    {
      "name": "🤖 IA - Ollama LOCAL (localhost)",
      "item": [
        {
          "name": "Health check LOCAL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:11434/api/tags",
              "protocol": "http",
              "host": ["localhost"],
              "port": "11434",
              "path": ["api", "tags"]
            },
            "description": "Verifica que Ollama esté corriendo localmente y lista los modelos disponibles (incluyendo gemma-erp)."
          }
        },
        {
          "name": "NLP ERP - Registrar compra",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"gemma-erp\",\n  \"prompt\": \"Extract ERP intent from: 'Register a purchase of rice, 50 units at 20 bolivianos, supplier ABC'. Respond ONLY with JSON: {\\\"intent\\\": \\\"compra_registrar\\\", \\\"producto\\\": \\\"...\\\", \\\"cantidad\\\": N, \\\"precio\\\": N, \\\"proveedor\\\": \\\"...\\\"}\",\n  \"stream\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "http://localhost:11434/api/generate",
              "protocol": "http",
              "host": ["localhost"],
              "port": "11434",
              "path": ["api", "generate"]
            }
          }
        },
        {
          "name": "NLP ERP - Registrar venta (español)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"gemma-erp\",\n  \"prompt\": \"Extrae la intención ERP de: 'Registrar venta de arroz 10 unidades para Juan Perez'. Responde SOLO con JSON: {\\\"intent\\\": \\\"venta_registrar\\\", \\\"producto\\\": \\\"...\\\", \\\"cantidad\\\": N, \\\"cliente\\\": \\\"...\\\"}\",\n  \"stream\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "http://localhost:11434/api/generate",
              "protocol": "http",
              "host": ["localhost"],
              "port": "11434",
              "path": ["api", "generate"]
            }
          }
        },
