      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
          "pm.request.headers.upsert({ key: 'x-api-role', value: 'admin' });",
          "pm.request.headers.upsert({ key: 'x-tenant-id', value: 'default' });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Listar clientes",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-role", "value": "admin" },
              { "key": "x-tenant-id", "value": "default" }
            ],
            "url": {
              "raw": "{{base_url}}/clientes",
              "host": ["{{base_url}}"],
              "path": ["clientes"]
            }
          }
        },
        {
          "name": "Crear cliente",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-role", "value": "admin" },
              { "key": "x-tenant-id", "value": "default" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Perez\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/clientes",
              "host": ["{{base_url}}"],
              "path": ["clientes"]
            }
          }
        },
        {
          "name": "Eliminar cliente",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-role", "value": "admin" },
              { "key": "x-tenant-id", "value": "default" }
            ],
            "url": {
              "raw": "{{base_url}}/clientes/:id",
              "host": ["{{base_url}}"],
              "path": ["clientes", ":id"],
              "variable": [{ "key": "id", "value": "CLIENTE_ID_AQUI" }]
            }
          }
        }
